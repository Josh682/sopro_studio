{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"name": "Audio Quick Toolkit Design Tokens",
"version": "2.0.0",
"colors": {
"background": {
"app": "#090B0E",
"surface_card": "#131720",
"surface_card_hover": "#181E2A",
"surface_rack": "#11141A",
"surface_well": "#0A0C10"
},
"text": {
"primary": "#F0F3F8",
"secondary": "#8E9AA8",
"muted": "#525D6B",
"button_dark": "#090B0E"
},
"border": {
"subtle": "rgba(255, 255, 255, 0.07)",
"card": "rgba(255, 255, 255, 0.12)",
"card_hover": "rgba(255, 255, 255, 0.22)",
"highlight": "rgba(255, 255, 255, 0.18)",
"focus": "#3B82F6"
},
"accents": {
"converter": { "base": "#5B9BFA", "darker": "#2D5EA6", "glow": "rgba(91, 155, 250, 0.30)" },
"separator": { "base": "#FF8A50", "darker": "#B84A17", "glow": "rgba(255, 138, 80, 0.30)" },
"combiner":  { "base": "#6EE795", "darker": "#2EA053", "glow": "rgba(110, 231, 149, 0.30)" },
"detect":    { "base": "#FCD34D", "darker": "#B5911B", "glow": "rgba(252, 211, 77, 0.30)" },
"pitch":     { "base": "#F472B6", "darker": "#AD3071", "glow": "rgba(244, 114, 182, 0.30)" },
"tempo":     { "base": "#2DD4BF", "darker": "#0F8273", "glow": "rgba(45, 212, 191, 0.30)" },
"trim":      { "base": "#FB7185", "darker": "#BA243B", "glow": "rgba(251, 113, 133, 0.30)" },
"normalize": { "base": "#38BDF8", "darker": "#0C7DB1", "glow": "rgba(56, 189, 248, 0.30)" },
"info":      { "base": "#A78BFA", "darker": "#6341C7", "glow": "rgba(167, 139, 250, 0.30)" }
},
"semantic": {
"success": "#22C55E",
"warning": "#F59E0B",
"error": "#EF4444"
}
},
"dimensions": {
"window": {
"default_width": 1152,
"default_height": 768,
"min_width": 1024,
"min_height": 680
},
"shell": {
"titlebar_height": 44,
"margin_x": 32,
"margin_y": 24
},
"grid": {
"columns": 3,
"rows": 3,
"gap_x": 24,
"gap_y": 20,
"card_height": 194
},
"workspace": {
"slot1_topbar_height": 48,
"slot2_deck_height": 210,
"slot3_rack_height": 280,
"slot4_footer_height": 64
},
"button": {
"launcher_height": 38,
"workspace_footer_height": 44,
"bevel_depth": 4,
"pressed_translation_y": 3,
"pressed_bevel_depth": 1
},
"vu_meter": {
"width": 320,
"height": 180,
"pivot_x": 160.0,
"pivot_y": 195.0,
"needle_length": 155.0,
"arc_min_deg": -45.0,
"arc_max_deg": 45.0
}
},
"radii": {
"sm": 4,
"md": 8,
"lg": 14,
"full": 9999
},
"spacing": {
"space_1": 4,
"space_2": 8,
"space_3": 12,
"space_4": 16,
"space_5": 20,
"space_6": 24,
"space_8": 32
},
"typography": {
"font_family_ui": "Inter",
"font_family_mono": "JetBrains Mono",
"title_h1": { "size": 18, "weight": 600, "line_height": 24 },
"title_card": { "size": 16, "weight": 600, "line_height": 22 },
"body_regular": { "size": 13, "weight": 400, "line_height": 17 },
"body_small": { "size": 11, "weight": 400, "line_height": 15 },
"data_mono_lg": { "size": 28, "weight": 700, "line_height": 32 },
"data_mono_md": { "size": 14, "weight": 500, "line_height": 18 },
"data_mono_sm": { "size": 11, "weight": 500, "line_height": 14 }
},
"physics": {
"vu_meter": {
"stiffness": 0.18,
"damping": 0.72,
"fps": 60,
"interval_ms": 16
}
}
}