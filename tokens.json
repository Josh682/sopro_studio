  "shadows": {
    "card": {
      "css": "inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 -1px 0 rgba(0, 0, 0, 0.65), 0 4px 10px rgba(0, 0, 0, 0.45)",
      "description": "Raised bronze plate bevel per DESIGN.md"
    },
    "inset": {
      "css": "inset 0 2px 6px rgba(0, 0, 0, 0.85), inset 0 -1px 0 rgba(255, 255, 255, 0.04), 0 1px 1px rgba(255, 255, 255, 0.03)",
      "description": "Recessed cavity/well for displays and faders: sharp ceiling occlusion (inset 0 2px 6px), subtle lower lip bounce (inset 0 -1px 0), outer edge highlight (0 1px 1px)"
    },
    "bevel": {
      "css": "inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 -3px 0 rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.45)",
      "description": "Raised backlit/square button bevel per DESIGN.md: top highlight, 3px bottom lip, contact shadow"
    },
    "bevel_pressed": {
      "css": "inset 0 1px 0 rgba(0, 0, 0, 0.85), inset 0 -1px 0 rgba(255, 255, 255, 0.08)",
      "description": "Pressed/recessed state: dark top edge, light bottom edge, no drop shadow"
    }
